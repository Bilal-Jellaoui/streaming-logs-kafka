      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Phase 2 - Pic de trafic" enabled="false">
        <stringProp name="TestPlan.comments">Simulation d&apos;un pic de trafic sur le site e-commerce SoukLine avec 100 utilisateurs virtuels, une montée en charge de 30 secondes et 50 répétitions par utilisateur. L&apos;objectif est de générer environ 10 000 requêtes HTTP sur les pages /panier et /checkout afin d&apos;évaluer les performances du serveur, mesurer les temps de réponse, détecter les erreurs et produire un volume important de logs pour leur traitement parallèle en streaming avec Apache Kafka.</stringProp>
        <intProp name="ThreadGroup.num_threads">100</intProp>
        <intProp name="ThreadGroup.ramp_time">30</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">50</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="Phase 2 - Gestion des sessions" enabled="true">
          <collectionProp name="CookieManager.cookies"/>
          <stringProp name="TestPlan.comments">Gestion des cookies HTTP et des sessions utilisateurs pendant la Phase 2 (pic de trafic). Chaque utilisateur virtuel conserve sa propre session et son panier entre les requêtes HTTP. Les cookies ne sont pas supprimés à chaque itération afin de simuler une navigation réaliste sur SoukLine et de garantir la continuité du parcours d&apos;achat jusqu&apos;au checkout.</stringProp>
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
          <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
        </CookieManager>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Phase 2 - Initialisation du panier" enabled="true">
          <stringProp name="TestPlan.comments">Exécute l&apos;ajout au panier une seule fois pour chaque utilisateur virtuel au début de la Phase 2. Ce contrôleur initialise les sessions d&apos;achat avant les requêtes répétées sur /panier et /checkout, afin de simuler un pic de trafic réaliste sans ajouter inutilement le même produit à chaque itération.</stringProp>
        </OnceOnlyController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - Ajouter au panier (Phase 2)" enabled="true">
            <stringProp name="TestPlan.comments">Initialise le panier de chaque utilisateur virtuel pendant la Phase 2 du test de charge SoukLine. Cette requête POST ajoute un produit à la session HTTP afin de permettre un parcours réaliste vers les pages /panier et /checkout. Elle prépare le scénario de pic de trafic et génère une véritable entrée dans le fichier access.log du serveur Spring Boot.</stringProp>
            <stringProp name="HTTPSampler.domain">localhost</stringProp>
            <stringProp name="HTTPSampler.port">8080</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/panier/ajouter</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
                <elementProp name="productId" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">2</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">productId</stringProp>
                </elementProp>
                <elementProp name="quantity" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">1</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">quantity</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET - Panier (Phase 2)" enabled="true">
          <stringProp name="TestPlan.comments">Simule un accès intensif à la page /panier pendant la Phase 2 du test de charge SoukLine. Cette requête permet de mesurer le temps de réponse du serveur sous forte charge et de générer des logs HTTP réels pour leur traitement en streaming avec Apache Kafka. Elle fait partie du scénario de pic de trafic défini dans le document de répartition du travail de l&apos;équipe.</stringProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/panier</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET - Checkout (Phase 2)" enabled="true">
          <stringProp name="TestPlan.comments">Simule un accès intensif à la page de paiement /checkout pendant la Phase 2 du test de charge SoukLine. Cette requête est répétée pour chaque utilisateur virtuel afin de mesurer les temps de réponse du serveur sous forte charge, détecter les éventuelles erreurs HTTP et générer des logs réels pour le traitement parallèle en streaming avec Apache Kafka.</stringProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/checkout</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="Phase 2 - HTTP Results" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
